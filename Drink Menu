:root {
  --navy: #0f1c3f;
  --navy-mid: #162550;
  --navy-light: #1e3370;
  --red: #C0272D;
  --white: #EEF2FA;
  --muted: #7a8aaa;
  --gold: #F5C842;
  --cyan: #4dd9e0;
}

body {
  background: var(--navy);
  font-family: 'Barlow', sans-serif;
  color: var(--white);
}

/* ── HEADER ── */
header {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: rgba(15,28,63,0.97);
  border-bottom: 1px solid rgba(192,39,45,0.35);
  backdrop-filter: blur(8px);
}

.header-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 2rem;
  height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
}

.logo { display: flex; align-items: center; gap: 0.75rem; text-decoration: none; flex-shrink: 0; }
.logo-img-wrap { width: 56px; height: 56px; border-radius: 50%; overflow: hidden; border: 2px solid var(--red); flex-shrink: 0; background: var(--navy-mid); transition: transform 0.3s ease; }
.logo:hover .logo-img-wrap { transform: scale(1.06); }
.logo-img { width: 100%; height: 100%; object-fit: cover; display: block; }
.logo-text { display: flex; flex-direction: column; line-height: 1; }
.logo-name { font-family: 'Bebas Neue', sans-serif; font-size: 1.65rem; letter-spacing: 0.1em; color: var(--white); }
.logo-tagline { font-family: 'Barlow Condensed', sans-serif; font-size: 0.65rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--red); font-weight: 600; }

nav { display: flex; align-items: center; gap: 0.25rem; }
nav a { font-family: 'Barlow Condensed', sans-serif; font-size: 0.9rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; text-decoration: none; color: var(--muted); padding: 0.45rem 0.85rem; position: relative; transition: color 0.2s ease; }
nav a::after { content: ''; position: absolute; bottom: 0; left: 50%; right: 50%; height: 2px; background: var(--red); transition: left 0.25s ease, right 0.25s ease; }
nav a:hover { color: var(--white); }
nav a:hover::after { left: 0.85rem; right: 0.85rem; }
nav a.active { color: var(--red); }
.nav-divider { width: 1px; height: 14px; background: rgba(255,255,255,0.12); }

.hamburger { display: none; flex-direction: column; gap: 5px; cursor: pointer; padding: 6px; }
.hamburger span { display: block; width: 24px; height: 2px; background: var(--white); }

@media (max-width: 680px) {
  .hamburger { display: flex; }
  nav { display: none; position: absolute; top: 76px; left: 0; right: 0; background: rgba(15,28,63,0.98); flex-direction: column; align-items: stretch; padding: 1rem 0; border-top: 1px solid rgba(192,39,45,0.3); backdrop-filter: blur(8px); }
  nav.open { display: flex; }
  nav a { padding: 0.75rem 2rem; }
  nav a::after { display: none; }
  .nav-divider { display: none; }
}

/* ── PAGE HERO ── */
.page-hero {
  margin-top: 76px;
  background:
    linear-gradient(160deg, rgba(192,39,45,0.12) 0%, transparent 50%),
    repeating-linear-gradient(0deg, transparent, transparent 59px, rgba(255,255,255,0.03) 59px, rgba(255,255,255,0.03) 60px),
    repeating-linear-gradient(90deg, transparent, transparent 59px, rgba(255,255,255,0.03) 59px, rgba(255,255,255,0.03) 60px),
    var(--navy);
  padding: 4rem 2rem;
  text-align: center;
  border-bottom: 1px solid rgba(192,39,45,0.2);
}

.page-eyebrow { font-family: 'Barlow Condensed', sans-serif; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.4em; text-transform: uppercase; color: var(--red); margin-bottom: 0.5rem; }
.page-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(3rem, 8vw, 6rem); letter-spacing: 0.06em; line-height: 1; color: var(--white); }
.page-title .accent { color: var(--red); }
.page-subtitle { font-family: 'Barlow', sans-serif; font-size: 1rem; color: var(--muted); margin-top: 1rem; max-width: 520px; margin-left: auto; margin-right: auto; line-height: 1.7; }

/* ── TABS ── */
.tabs-bar { background: var(--navy-mid); border-bottom: 1px solid rgba(255,255,255,0.06); position: sticky; top: 76px; z-index: 90; overflow-x: auto; }
.tabs-inner { max-width: 1280px; margin: 0 auto; padding: 0 2rem; display: flex; gap: 0; white-space: nowrap; }
.tab-btn { font-family: 'Bebas Neue', sans-serif; font-size: 1rem; letter-spacing: 0.12em; color: var(--muted); background: none; border: none; border-bottom: 3px solid transparent; padding: 1rem 1.25rem; cursor: pointer; transition: color 0.2s ease, border-color 0.2s ease; }
.tab-btn:hover { color: var(--white); }
.tab-btn.active { color: var(--white); border-bottom-color: var(--red); }

/* ── SHARED ── */
.menu-panel { display: none; }
.menu-panel.active { display: block; }

.section-wrap { max-width: 1280px; margin: 0 auto; padding: 4rem 2rem; }

.menu-section-title {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  letter-spacing: 0.1em;
  color: var(--white);
  margin-bottom: 0.25rem;
  padding-bottom: 0.75rem;
  border-bottom: 2px solid var(--red);
  display: inline-block;
}

.menu-section-title .accent { color: var(--red); }

/* ── BOTTLES & CANS ── */
.bottles-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2.5rem;
  margin-top: 2.5rem;
}

.beer-col-title {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--cyan);
  margin-bottom: 1rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid rgba(77,217,224,0.25);
}

.beer-list { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
.beer-list li { font-family: 'Barlow Condensed', sans-serif; font-size: 0.95rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--white); }
.beer-list li.sub { font-weight: 400; color: var(--muted); text-transform: none; font-size: 0.88rem; padding-left: 0.75rem; }
.beer-list li.brand { color: var(--gold); margin-top: 0.5rem; }

@media (max-width: 900px) { .bottles-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 480px) { .bottles-grid { grid-template-columns: 1fr; } }

/* ── COCKTAILS / MOCKTAILS ── */
.cocktails-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  margin-top: 2.5rem;
}

.cocktail-col-title {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--cyan);
  margin-bottom: 1.5rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid rgba(77,217,224,0.25);
}

.cocktail-item { display: flex; flex-direction: column; gap: 0.25rem; margin-bottom: 1.5rem; }
.cocktail-name-row { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
.cocktail-name { font-family: 'Bebas Neue', sans-serif; font-size: 1.2rem; letter-spacing: 0.08em; color: var(--white); }
.cocktail-price { font-family: 'Bebas Neue', sans-serif; font-size: 1.1rem; color: var(--gold); white-space: nowrap; }
.cocktail-ingredients { font-family: 'Barlow', sans-serif; font-size: 0.82rem; color: var(--muted); line-height: 1.5; }

@media (max-width: 680px) { .cocktails-grid { grid-template-columns: 1fr; } }

/* ── NON-ALC & WINE ── */
.nonalc-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  margin-top: 2.5rem;
}

.nonalc-sub-title {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--muted);
  margin: 1.5rem 0 0.75rem;
  padding-bottom: 0.4rem;
  border-bottom: 1px solid rgba(255,255,255,0.07);
}

.nonalc-box {
  border: 1px solid rgba(77,217,224,0.2);
  border-radius: 6px;
  padding: 1rem 1.25rem;
  margin-bottom: 1rem;
}

.nonalc-box-title {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 0.9rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--cyan);
  margin-bottom: 0.5rem;
}

.wine-brand {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 0.9rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 0.5rem;
}

.wine-highlight {
  border: 1px solid #d63384;
  border-radius: 6px;
  padding: 0.75rem 1.25rem;
  margin-top: 1rem;
  color: #f599c8;
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: 0.1em;
}

@media (max-width: 680px) { .nonalc-grid { grid-template-columns: 1fr; } }

/* ── WEEKLY SPECIALS ── */
.specials-everday {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 1.1rem;
  letter-spacing: 0.15em;
  color: var(--gold);
  text-align: center;
  background: rgba(245,200,66,0.08);
  border: 1px solid rgba(245,200,66,0.2);
  border-radius: 6px;
  padding: 0.85rem 2rem;
  margin-bottom: 2.5rem;
}

.specials-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 1rem;
}

.special-card {
  background: var(--navy);
  border: 1px solid rgba(255,255,255,0.07);
  border-radius: 8px;
  overflow: hidden;
  transition: transform 0.2s ease, border-color 0.2s ease;
}

.special-card:hover { transform: translateY(-3px); border-color: rgba(192,39,45,0.4); }

.special-day {
  background: var(--navy-light);
  font-family: 'Bebas Neue', sans-serif;
  font-size: 1rem;
  letter-spacing: 0.15em;
  color: var(--white);
  text-align: center;
  padding: 0.5rem;
}

.special-body { padding: 1rem; display: flex; flex-direction: column; gap: 0.6rem; }

.special-item {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--white);
  line-height: 1.4;
}

.special-item em {
  font-style: normal;
  color: var(--gold);
}

.special-divider { height: 1px; background: rgba(255,255,255,0.07); }

@media (max-width: 900px) { .specials-grid { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 580px) { .specials-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 380px) { .specials-grid { grid-template-columns: 1fr; } }

/* ── FOOTER ── */
footer { background: #06080f; border-top: 1px solid rgba(192,39,45,0.3); }
.footer-inner { max-width: 1280px; margin: 0 auto; padding: 3rem 2rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 2rem; }
.footer-brand { display: flex; align-items: center; gap: 0.85rem; }
.footer-logo-wrap { width: 52px; height: 52px; border-radius: 50%; overflow: hidden; border: 2px solid var(--red); flex-shrink: 0; background: var(--navy-mid); }
.footer-logo-img { width: 100%; height: 100%; object-fit: cover; display: block; }
.footer-logo-name { font-family: 'Bebas Neue', sans-serif; font-size: 1.4rem; letter-spacing: 0.1em; color: var(--white); line-height: 1; }
.footer-logo-tag { font-family: 'Barlow Condensed', sans-serif; font-size: 0.65rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--muted); margin-top: 0.2rem; }
.footer-phone { font-family: 'Barlow Condensed', sans-serif; font-size: 1.1rem; font-weight: 700; letter-spacing: 0.1em; color: var(--white); text-decoration: none; display: flex; align-items: center; gap: 0.5rem; transition: color 0.2s ease; }
.footer-phone:hover { color: var(--red); }
.footer-social { display: flex; align-items: center; gap: 0.75rem; }
.social-icon { display: flex; align-items: center; justify-content: center; width: 42px; height: 42px; border-radius: 50%; border: 1px solid rgba(255,255,255,0.12); color: var(--muted); text-decoration: none; transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease; }
.social-icon:hover { background: #1877F2; color: var(--white); border-color: #1877F2; }
.social-icon.instagram:hover { background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90%); color: var(--white); border-color: transparent; }
.social-icon.tiktok:hover { background: #010101; color: var(--white); border-color: #69C9D0; }
.footer-bottom { border-top: 1px solid rgba(255,255,255,0.06); padding: 1.25rem 2rem; max-width: 1280px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; }
.footer-disclaimer { font-family: 'Barlow Condensed', sans-serif; font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--red); opacity: 0.8; }
.footer-copy { font-family: 'Barlow', sans-serif; font-size: 0.75rem; color: var(--muted); opacity: 0.6; }
@media (max-width: 680px) { .footer-inner { justify-content: center; text-align: center; } .footer-brand { flex-direction: column; align-items: center; } .footer-bottom { justify-content: center; text-align: center; } }
