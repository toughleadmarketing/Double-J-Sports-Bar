:root {
  --navy: #0f1c3f;
  --navy-mid: #162550;
  --navy-light: #1e3370;
  --red: #C0272D;
  --white: #EEF2FA;
  --muted: #7a8aaa;
  --gold: #F5C842;
}

body {
  background: var(--navy);
  font-family: 'Barlow', sans-serif;
  color: var(--white);
}

/* ── HEADER ── */
header {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: rgba(15,28,63,0.97);
  border-bottom: 1px solid rgba(192,39,45,0.35);
  backdrop-filter: blur(8px);
}

.header-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 2rem;
  height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
}

.logo {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  text-decoration: none;
  flex-shrink: 0;
}

.logo-img-wrap {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  overflow: hidden;
  border: 2px solid var(--red);
  flex-shrink: 0;
  background: var(--navy-mid);
  transition: transform 0.3s ease;
}

.logo:hover .logo-img-wrap { transform: scale(1.06); }
.logo-img { width: 100%; height: 100%; object-fit: cover; display: block; }
.logo-text { display: flex; flex-direction: column; line-height: 1; }

.logo-name {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 1.65rem;
  letter-spacing: 0.1em;
  color: var(--white);
}

.logo-tagline {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 0.65rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--red);
  font-weight: 600;
}

nav {
  display: flex;
  align-items: center;
  gap: 0.25rem;
}

nav a {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 0.9rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  text-decoration: none;
  color: var(--muted);
  padding: 0.45rem 0.85rem;
  position: relative;
  transition: color 0.2s ease;
}

nav a::after {
  content: '';
  position: absolute;
  bottom: 0; left: 50%; right: 50%;
  height: 2px;
  background: var(--red);
  transition: left 0.25s ease, right 0.25s ease;
}

nav a:hover { color: var(--white); }
nav a:hover::after { left: 0.85rem; right: 0.85rem; }
nav a.active { color: var(--red); }

.nav-divider {
  width: 1px;
  height: 14px;
  background: rgba(255,255,255,0.12);
}

.hamburger {
  display: none;
  flex-direction: column;
  gap: 5px;
  cursor: pointer;
  padding: 6px;
}
.hamburger span { display: block; width: 24px; height: 2px; background: var(--white); }

@media (max-width: 680px) {
  .hamburger { display: flex; }
  nav {
    display: none;
    position: absolute;
    top: 76px; left: 0; right: 0;
    background: rgba(15,28,63,0.98);
    flex-direction: column;
    align-items: stretch;
    padding: 1rem 0;
    border-top: 1px solid rgba(192,39,45,0.3);
    backdrop-filter: blur(8px);
  }
  nav.open { display: flex; }
  nav a { padding: 0.75rem 2rem; }
  nav a::after { display: none; }
  .nav-divider { display: none; }
}

/* ── PAGE HERO ── */
.page-hero {
  margin-top: 76px;
  background:
    linear-gradient(160deg, rgba(192,39,45,0.12) 0%, transparent 50%),
    repeating-linear-gradient(0deg, transparent, transparent 59px, rgba(255,255,255,0.03) 59px, rgba(255,255,255,0.03) 60px),
    repeating-linear-gradient(90deg, transparent, transparent 59px, rgba(255,255,255,0.03) 59px, rgba(255,255,255,0.03) 60px),
    var(--navy);
  padding: 4rem 2rem;
  text-align: center;
  border-bottom: 1px solid rgba(192,39,45,0.2);
}

.page-eyebrow {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.4em;
  text-transform: uppercase;
  color: var(--red);
  margin-bottom: 0.5rem;
}

.page-title {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(3rem, 8vw, 6rem);
  letter-spacing: 0.06em;
  line-height: 1;
  color: var(--white);
}

.page-title .accent { color: var(--red); }

.page-subtitle {
  font-family: 'Barlow', sans-serif;
  font-size: 1rem;
  color: var(--muted);
  margin-top: 1rem;
  max-width: 520px;
  margin-left: auto;
  margin-right: auto;
  line-height: 1.7;
}

/* ── SPORT TABS ── */
.tabs-bar {
  background: var(--navy-mid);
  border-bottom: 1px solid rgba(255,255,255,0.06);
  position: sticky;
  top: 76px;
  z-index: 90;
}

.tabs-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 2rem;
  display: flex;
  gap: 0;
}

.tab-btn {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 1rem;
  letter-spacing: 0.12em;
  color: var(--muted);
  background: none;
  border: none;
  border-bottom: 3px solid transparent;
  padding: 1rem 1.5rem;
  cursor: pointer;
  transition: color 0.2s ease, border-color 0.2s ease;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.tab-btn:hover { color: var(--white); }

.tab-btn.active {
  color: var(--white);
  border-bottom-color: var(--red);
}

.tab-badge {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 0.65rem;
  font-weight: 700;
  background: var(--red);
  color: var(--white);
  border-radius: 20px;
  padding: 0.1rem 0.45rem;
  letter-spacing: 0.05em;
  display: none;
}

.tab-badge.show { display: inline-block; }

/* ── SCHEDULE SECTION ── */
.schedule-section {
  padding: 3rem 0 5rem;
}

.schedule-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 2rem;
}

.sport-panel { display: none; }
.sport-panel.active { display: block; }

.sport-header {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 2rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid rgba(255,255,255,0.07);
}

.sport-icon {
  font-size: 2rem;
  line-height: 1;
}

.sport-label {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 2rem;
  letter-spacing: 0.08em;
  color: var(--white);
}

.sport-updated {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 0.72rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--muted);
  margin-left: auto;
}

/* ── GAME CARDS ── */
.games-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
}

.game-card {
  background: var(--navy-mid);
  border: 1px solid rgba(255,255,255,0.07);
  border-radius: 8px;
  padding: 1.25rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  transition: border-color 0.2s ease, transform 0.2s ease;
}

.game-card:hover {
  border-color: rgba(192,39,45,0.35);
  transform: translateY(-2px);
}

.game-card.live {
  border-color: var(--red);
  background: rgba(192,39,45,0.06);
}

.game-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.status-badge {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  padding: 0.2rem 0.6rem;
  border-radius: 20px;
}

.status-live {
  background: var(--red);
  color: var(--white);
  animation: pulse 1.5s ease infinite;
}

.status-final {
  background: rgba(255,255,255,0.08);
  color: var(--muted);
}

.status-upcoming {
  background: rgba(30,51,112,0.8);
  color: #7a9fff;
  border: 1px solid rgba(122,159,255,0.2);
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

.game-detail {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 0.72rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
}

.game-matchup {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.game-team {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
}

.team-info {
  display: flex;
  align-items: center;
  gap: 0.6rem;
}

.team-logo {
  width: 28px;
  height: 28px;
  object-fit: contain;
  border-radius: 50%;
  background: rgba(255,255,255,0.05);
}

.team-name {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  color: var(--white);
}

.team-record {
  font-family: 'Barlow', sans-serif;
  font-size: 0.7rem;
  color: var(--muted);
}

.team-score {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 1.5rem;
  letter-spacing: 0.05em;
  color: var(--white);
  min-width: 2rem;
  text-align: right;
}

.team-score.winner { color: var(--gold); }

.game-divider {
  height: 1px;
  background: rgba(255,255,255,0.06);
}

.game-time {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  color: #7a9fff;
}

/* Loading & empty states */
.loading-state,
.empty-state {
  grid-column: 1 / -1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 4rem 2rem;
  text-align: center;
  color: var(--muted);
  gap: 1rem;
}

.loading-spinner {
  width: 36px;
  height: 36px;
  border: 3px solid rgba(255,255,255,0.08);
  border-top-color: var(--red);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.empty-icon { font-size: 2.5rem; opacity: 0.4; }

.empty-text {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 1rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

@media (max-width: 900px) {
  .games-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 580px) {
  .games-grid { grid-template-columns: 1fr; }
  .tabs-inner { overflow-x: auto; }
}

/* ── THIS WEEK AT DOUBLE J ── */
.weekly-section {
  background: var(--navy-mid);
  padding: 5rem 0;
}

.weekly-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 2rem;
}

.weekly-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.25rem;
}

.weekly-card {
  background: var(--navy);
  border: 1px solid rgba(255,255,255,0.07);
  border-radius: 8px;
  overflow: hidden;
  transition: transform 0.25s ease, border-color 0.25s ease;
}

.weekly-card:hover {
  transform: translateY(-4px);
  border-color: rgba(192,39,45,0.4);
}

.weekly-card.featured {
  border-color: var(--red);
  grid-column: span 2;
}

.weekly-day {
  background: var(--red);
  font-family: 'Bebas Neue', sans-serif;
  font-size: 1rem;
  letter-spacing: 0.2em;
  color: var(--white);
  padding: 0.5rem 1.25rem;
}

.weekly-card.featured .weekly-day {
  background: var(--red);
  font-size: 1.1rem;
}

.weekly-body {
  padding: 1.25rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.weekly-time {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
}

.weekly-name {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 1.4rem;
  letter-spacing: 0.06em;
  color: var(--white);
  line-height: 1;
}

.weekly-card.featured .weekly-name { font-size: 1.7rem; }

.weekly-desc {
  font-family: 'Barlow', sans-serif;
  font-size: 0.85rem;
  color: var(--muted);
  line-height: 1.6;
}

.weekly-tag {
  display: inline-block;
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  padding: 0.2rem 0.65rem;
  border-radius: 20px;
  border: 1px solid rgba(192,39,45,0.4);
  color: var(--red);
  margin-top: 0.25rem;
  width: fit-content;
}

.weekly-card.featured .weekly-tag {
  background: var(--red);
  color: var(--white);
  border-color: var(--red);
}

@media (max-width: 900px) {
  .weekly-grid { grid-template-columns: repeat(2, 1fr); }
  .weekly-card.featured { grid-column: span 1; }
}

@media (max-width: 580px) {
  .weekly-grid { grid-template-columns: 1fr; }
  .weekly-card.featured { grid-column: span 1; }
}

