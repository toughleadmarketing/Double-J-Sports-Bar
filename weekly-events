  <script>
    document.getElementById('footer-year').textContent = new Date().getFullYear();

    document.getElementById('hamburger').addEventListener('click', () => {
      document.getElementById('main-nav').classList.toggle('open');
    });

    // ── Tab switching ──
    function switchTab(sport) {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.sport-panel').forEach(p => p.classList.remove('active'));
      document.querySelector(`[data-sport="${sport}"]`).classList.add('active');
      document.getElementById(`panel-${sport}`).classList.add('active');
    }

    // ── ESPN API ──
    const SPORTS = [
      { key: 'mlb',    path: 'baseball/mlb',               label: 'MLB'  },
      { key: 'nhl',    path: 'hockey/nhl',                 label: 'NHL'  },
      { key: 'ncaamb', path: 'basketball/mens-college-basketball', label: 'NCAAMB' },
    ];

    function formatTime(dateStr) {
      try {
        const d = new Date(dateStr);
        return d.toLocaleString('en-US', {
          weekday: 'short', month: 'short', day: 'numeric',
          hour: 'numeric', minute: '2-digit', timeZoneName: 'short'
        });
      } catch { return dateStr; }
    }

    function buildCard(event) {
      const comp   = event.competitions[0];
      const home   = comp.competitors.find(c => c.homeAway === 'home');
      const away   = comp.competitors.find(c => c.homeAway === 'away');
      const status = event.status.type;
      const detail = event.status.type.shortDetail || '';

      const isLive   = status.state === 'in';
      const isFinal  = status.state === 'post';
      const isPre    = status.state === 'pre';

      const homeScore = home?.score ?? '';
      const awayScore = away?.score ?? '';
      const homeName  = home?.team?.shortDisplayName || home?.team?.abbreviation || '';
      const awayName  = away?.team?.shortDisplayName || away?.team?.abbreviation || '';
      const homeLogo  = home?.team?.logo || '';
      const awayLogo  = away?.team?.logo || '';
      const homeRec   = home?.records?.[0]?.summary || '';
      const awayRec   = away?.records?.[0]?.summary || '';

      let homeWin = false, awayWin = false;
      if (isFinal && homeScore !== '' && awayScore !== '') {
        homeWin = parseInt(homeScore) > parseInt(awayScore);
        awayWin = parseInt(awayScore) > parseInt(homeScore);
      }

      const badgeHtml = isLive
        ? `<span class="status-badge status-live">● Live</span>`
        : isFinal
        ? `<span class="status-badge status-final">Final</span>`
        : `<span class="status-badge status-upcoming">Upcoming</span>`;

      const timeHtml = isPre
        ? `<div class="game-time">${formatTime(event.date)}</div>`
        : `<div class="game-detail">${detail}</div>`;

      const logoStyle = 'width:28px;height:28px;object-fit:contain;border-radius:50%;background:rgba(255,255,255,0.05);';

      return `
        <div class="game-card ${isLive ? 'live' : ''}">
          <div class="game-status">
            ${badgeHtml}
            <div class="game-detail">${comp.venue?.fullName || ''}</div>
          </div>
          <div class="game-matchup">
            <div class="game-team">
              <div class="team-info">
                ${awayLogo ? `<img src="${awayLogo}" style="${logoStyle}" alt="${awayName}"/>` : ''}
                <div>
                  <div class="team-name">${awayName}</div>
                  ${awayRec ? `<div class="team-record">${awayRec}</div>` : ''}
                </div>
              </div>
              ${!isPre ? `<div class="team-score ${awayWin ? 'winner' : ''}">${awayScore}</div>` : ''}
            </div>
            <div class="game-divider"></div>
            <div class="game-team">
              <div class="team-info">
                ${homeLogo ? `<img src="${homeLogo}" style="${logoStyle}" alt="${homeName}"/>` : ''}
                <div>
                  <div class="team-name">${homeName}</div>
                  ${homeRec ? `<div class="team-record">${homeRec}</div>` : ''}
                </div>
              </div>
              ${!isPre ? `<div class="team-score ${homeWin ? 'winner' : ''}">${homeScore}</div>` : ''}
            </div>
          </div>
          ${timeHtml}
        </div>`;
    }

    async function loadSport(sport) {
      const grid    = document.getElementById(`grid-${sport.key}`);
      const updated = document.getElementById(`updated-${sport.key}`);
      const badge   = document.getElementById(`badge-${sport.key}`);

      try {
        const res  = await fetch(`https://site.api.espn.com/apis/site/v2/sports/${sport.path}/scoreboard`);
        const data = await res.json();
        const events = data.events || [];

        if (events.length === 0) {
          grid.innerHTML = `<div class="empty-state"><div class="empty-icon">📅</div><div class="empty-text">No games scheduled right now</div></div>`;
          return;
        }

        // Sort: live first, then upcoming, then final
        const order = { in: 0, pre: 1, post: 2 };
        events.sort((a, b) => (order[a.status.type.state] ?? 3) - (order[b.status.type.state] ?? 3));

        const liveCount = events.filter(e => e.status.type.state === 'in').length;
        if (liveCount > 0) {
          badge.textContent = `${liveCount} Live`;
          badge.classList.add('show');
        }

        grid.innerHTML = events.map(buildCard).join('');
        updated.textContent = `Updated ${new Date().toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' })}`;

      } catch {
        grid.innerHTML = `<div class="empty-state"><div class="empty-icon">⚠️</div><div class="empty-text">Could not load schedule — please try again</div></div>`;
      }
    }

    // Load all sports on page load
    SPORTS.forEach(loadSport);

    // Auto-refresh every 60 seconds
    setInterval(() => SPORTS.forEach(loadSport), 60000);
  </script>

